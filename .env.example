# Saath runs fully without these values. With no provider configured, the app
# uses its on-device deterministic simulation and labels it clearly in the UI.
# Never prefix these with VITE_ — that would expose them to the browser.

# OpenAI-compatible chat-completions base URL (for example https://api.example.com/v1).
SAATH_AI_BASE_URL=
# Server-only API key. Keep this in .env (git-ignored) or your host's secret store.
SAATH_AI_API_KEY=
# Model identifier permitted for this use case.
SAATH_AI_MODEL=
# Human-readable provider label shown in integration status (optional).
SAATH_AI_PROVIDER_LABEL=

# Optional: restrict the dev preview hostname allowlist (Vite).
# PREVIEW_HOST=your-preview-host.example.com
