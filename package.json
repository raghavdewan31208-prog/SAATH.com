{
  "name": "saath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Saath — an evening travel and emergency communication companion",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
